// CV32 test bench files
${TBSRC_HOME}/uvmt/uvmt_cv32e40p_step_compare.sv
${TBSRC_HOME}/uvmt/uvmt_cv32e40p_iss_wrap.sv

// Vendor Libraries
// The design (typedefs/monitor/ram) is shared with the Imperas flow; only the
// RVVI adapter module differs. Selected with: make ... ISS=RUSTISS
+incdir+${DV_OVPM_DESIGN}
${DV_OVPM_DESIGN}/typedefs.sv
${DV_OVPM_DESIGN}/monitor.sv
${DV_OVPM_DESIGN}/ram.sv

// Rust ISS adapter. Build the model before elaborating:
//   cargo build --release --manifest-path <imperas-riscv-tests>/rust-iss/Cargo.toml
//   install -m 0755 <...>/target/release/libcv32dpi.so ${RUSTISS_HOME}/bin/libcv32dpi.so
+incdir+${RUSTISS_HOME}/sv
${RUSTISS_HOME}/sv/rustiss_CV32.sv